@model IReadOnlyCollection<ProyectoComunas.Web.Models.Comuna>
@{ ViewData["Title"] = "Comunas"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Comunas</h1>
    <a asp-controller="Region" asp-action="Index"
       class="btn btn-outline-secondary">Volver a regiones</a>
</div>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success">@mensaje</div>
}

<table class="table table-striped align-middle">
    <thead><tr><th>ID</th><th>Nombre</th><th></th></tr></thead>
    <tbody>
    @foreach (var comuna in Model)
    {
        <tr>
            <td>@comuna.IdComuna</td>
            <td>@comuna.NombreComuna</td>
            <td class="text-end">
                <a asp-action="Editar"
                   asp-route-idRegion="@comuna.IdRegion"
                   asp-route-idComuna="@comuna.IdComuna"
                   class="btn btn-outline-primary btn-sm">Editar</a>
            </td>
        </tr>
    }
    </tbody>
</table>
