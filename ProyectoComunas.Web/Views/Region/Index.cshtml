@model IReadOnlyCollection<ProyectoComunas.Web.Models.Region>
@{ ViewData["Title"] = "Regiones"; }

<h1>Regiones</h1>
<table class="table table-striped align-middle">
    <thead><tr><th>ID</th><th>Nombre</th><th></th></tr></thead>
    <tbody>
    @foreach (var region in Model)
    {
        <tr>
            <td>@region.IdRegion</td>
            <td>@region.NombreRegion</td>
            <td class="text-end">
                <a asp-controller="Comuna" asp-action="Index"
                   asp-route-idRegion="@region.IdRegion"
                   class="btn btn-primary btn-sm">Ver comunas</a>
            </td>
        </tr>
    }
    </tbody>
</table>
